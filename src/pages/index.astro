---
import Layout from '../layouts/Layout.astro';
import { getUserFromSession } from '../lib/auth';
import { getCloudflareEnv } from '../lib/getEnv';

const sessionId = Astro.cookies.get('days_counter_session')?.value;
const env = await getCloudflareEnv(Astro.locals);
let user = null;
if (env?.DB && sessionId) {
  try {
    user = await getUserFromSession(env.DB, sessionId);
  } catch (e) {
    user = null;
  }
}
---

<Layout title="عداد الأيام | تتبع المناسبات وحاسبة الفروق الزمنية">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32">
    <div class="absolute top-1/4 right-1/2 translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-emerald-500/15 dark:bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/3 left-10 w-72 h-72 bg-teal-500/10 dark:bg-teal-500/5 rounded-full blur-2xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>تطبيق ويب تقدمي متطور (PWA) باللغة العربية</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6">
          <span>تتبع كل لحظة،</span>{' '}
          <span class="bg-gradient-to-l from-emerald-600 via-teal-500 to-cyan-500 bg-clip-text text-transparent">
            واحسب كل يوم
          </span>{' '}
          <span>بدقة متناهية</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-10 max-w-2xl mx-auto">
          المنصة المتكاملة لحساب الفروق الزمنية، متابعة مواعيد ومناسباتك الهامة، والعد التنازلي مع تنبيهات مخصصة ودعم كامل للعمل بدون إنترنت.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          {user ? (
            <a
              href="/dashboard"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-base shadow-lg shadow-emerald-600/25 hover:shadow-emerald-600/40 hover:-translate-y-0.5 transition-all text-center"
            >
              الانتقال إلى عداد الأيام
            </a>
          ) : (
            <>
              <a
                href="/register"
                class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-base shadow-lg shadow-emerald-600/25 hover:shadow-emerald-600/40 hover:-translate-y-0.5 transition-all text-center"
              >
                ابدأ مجاناً الآن
              </a>
              <a
                href="/login"
                class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-100 font-bold text-base hover:bg-slate-50 dark:hover:bg-slate-800/80 transition-all text-center"
              >
                تسجيل الدخول
              </a>
            </>
          )}
          <a
            href="/calculator"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-emerald-600 dark:text-emerald-400 font-bold text-base hover:underline text-center"
          >
            جرب حاسبة المدة مباشرة &larr;
          </a>
        </div>
      </div>

      <!-- Live Interactive Demo Card -->
      <div class="mt-16 max-w-4xl mx-auto">
        <div class="relative rounded-2xl bg-gradient-to-b from-white to-slate-50/50 dark:from-slate-900 dark:to-slate-950 p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-2xl shadow-slate-900/10">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-slate-100 dark:border-slate-800/60">
            <div class="flex items-center gap-3">
              <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <div>
                <h2 class="font-bold text-lg">معاينة تفاعلية: مناسبة نموذجية</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">حساب فوري للأيام والأسابيع والشهور المتبقية</p>
              </div>
            </div>
            <div class="inline-flex rounded-lg bg-slate-100 dark:bg-slate-800 p-1 text-xs font-semibold">
              <span class="px-3 py-1 rounded-md bg-white dark:bg-slate-700 shadow-sm text-emerald-600 dark:text-emerald-300">
                قادمة قريباً
              </span>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-8 text-center" id="demo-counter-grid">
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <div class="text-3xl sm:text-4xl font-black text-emerald-600 dark:text-emerald-400 font-mono" id="demo-days">--</div>
              <div class="text-xs font-bold text-slate-500 dark:text-slate-400 mt-1">إجمالي الأيام</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <div class="text-3xl sm:text-4xl font-black text-slate-800 dark:text-slate-100 font-mono" id="demo-weeks">--</div>
              <div class="text-xs font-bold text-slate-500 dark:text-slate-400 mt-1">أسبوع</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <div class="text-3xl sm:text-4xl font-black text-slate-800 dark:text-slate-100 font-mono" id="demo-months">--</div>
              <div class="text-xs font-bold text-slate-500 dark:text-slate-400 mt-1">شهر</div>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <div class="text-3xl sm:text-4xl font-black text-teal-500 font-mono" id="demo-workdays">--</div>
              <div class="text-xs font-bold text-slate-500 dark:text-slate-400 mt-1">يوم عمل</div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-2">
            <span>الهدف المحدد: نهاية العام الميلادي الجديد</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">تطبيق PWA مع إمكانية التثبيت والإشعارات</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-16 bg-slate-100/60 dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">كل ما تحتاجه لإدارة الوقت والمناسبات</h2>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-3">
          تم تصميم عداد الأيام ليلبي احتياجاتك بدقة وسلاسة فائقة، مع الحفاظ على خصوصية بياناتك وتوافرها في أي وقت.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">عد تنازلي وتصاعدي ذكي</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            يتعرف النظام تلقائياً على ما إذا كان الحدث في المستقبل ليحسب "كم تبقى عليه"، أو حدثاً مضى ليحسب "كم مضى منذ حدوثه".
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">حاسبة الفترات وأيام العمل</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            احسب الفرق بين أي تاريخين بدقة متناهية، مع استخراج إجمالي الأيام، والشهور، والأسابيع، وأيام العمل المستثناة من عطلات نهاية الأسبوع.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-violet-500/10 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">إشعارات PWA وتنبيهات مجدولة</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            استقبل إشعارات فورية على هاتفك أو حاسوبك قبل المناسبة بيوم، أو تنبيهات دورية أسبوعية كل يوم جمعة حتى لا تفوتك أي مناسبة.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function updateDemo() {
      const now = new Date();
      const targetYear = now.getFullYear() + 1;
      const target = new Date(targetYear, 0, 1);
      
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const msDiff = target.getTime() - today.getTime();

      if (msDiff > 0) {
        const days = Math.round(msDiff / (1000 * 60 * 60 * 24));
        const weeks = Math.floor(days / 7);
        const months = Math.floor(days / 30);
        
        let workDays = 0;
        const cur = new Date(today);
        while (cur < target) {
          const d = cur.getDay();
          if (d !== 5 && d !== 6) workDays++;
          cur.setDate(cur.getDate() + 1);
        }

        const dEl = document.getElementById('demo-days');
        const wEl = document.getElementById('demo-weeks');
        const mEl = document.getElementById('demo-months');
        const workEl = document.getElementById('demo-workdays');

        if (dEl) dEl.textContent = days.toString();
        if (wEl) wEl.textContent = weeks.toString();
        if (mEl) mEl.textContent = months.toString();
        if (workEl) workEl.textContent = workDays.toString();
      }
    }

    updateDemo();
  </script>
</Layout>
