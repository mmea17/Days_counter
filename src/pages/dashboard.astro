---
import Layout from '../layouts/Layout.astro';
import { getUserFromSession } from '../lib/auth';
import { getCloudflareEnv } from '../lib/getEnv';
import { getDb } from '../db';
import { events } from '../db/schema';
import { eq } from 'drizzle-orm';

const sessionId = Astro.cookies.get('days_counter_session')?.value;
const env = await getCloudflareEnv(Astro.locals);

if (!env?.DB || !sessionId) {
  return Astro.redirect('/login');
}

const user = await getUserFromSession(env.DB, sessionId);
if (!user) {
  return Astro.redirect('/login');
}

// Fetch initial events
const db = getDb(env.DB);
const initialEvents = await db
  .select()
  .from(events)
  .where(eq(events.userId, user.id));

initialEvents.sort((a, b) => new Date(a.targetDate).getTime() - new Date(b.targetDate).getTime());
---

<Layout title="عداد الأيام والمناسبات | لوحة التحكم">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
    <!-- Top Welcome & Actions Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight">
            مرحباً، <span class="bg-gradient-to-l from-emerald-600 to-teal-500 bg-clip-text text-transparent">{user.name}</span> 👋
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          إليك جميع مناسباتك، العد التنازلي والتصاعدي، والتنبيهات المجدولة
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Test Notification Button -->
        <button
          id="test-push-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shadow-sm cursor-pointer"
        >
          <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span>اختبار إشعار فوري</span>
        </button>

        <!-- Add Event Button -->
        <button
          id="open-create-modal"
          type="button"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/30 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>إضافة حدث جديد</span>
        </button>
      </div>
    </div>

    <!-- Push Notification Subscription Banner -->
    <div
      id="push-prompt-banner"
      class="hidden mt-6 p-4 rounded-2xl bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-sky-500/10 border border-emerald-500/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
    >
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold">تفعيل التنبيهات المباشرة على هذا المتصفح</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            احصل على إشعارات PWA التلقائية قبل حلول موعد مناسباتك المحددة
          </p>
        </div>
      </div>
      <button
        id="enable-push-btn"
        type="button"
        class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition-all cursor-pointer whitespace-nowrap"
      >
        تفعيل التنبيهات الآن
      </button>
    </div>

    <!-- Notification Toast / Status Banner -->
    <div id="toast" class="hidden fixed bottom-6 left-6 z-50 p-4 rounded-xl shadow-xl text-xs font-bold transition-all max-w-sm"></div>

    <!-- Controls Bar: Filter & View Mode Toggles -->
    <div class="mt-8 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      <!-- Filter Tabs -->
      <div class="flex items-center gap-1.5 p-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold overflow-x-auto">
        <button type="button" data-filter="all" class="filter-tab px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm">
          الكل (<span id="count-all">0</span>)
        </button>
        <button type="button" data-filter="upcoming" class="filter-tab px-3.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200">
          المناسبات القادمة (<span id="count-upcoming">0</span>)
        </button>
        <button type="button" data-filter="past" class="filter-tab px-3.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200">
          المناسبات السابقة (<span id="count-past">0</span>)
        </button>
      </div>

      <!-- Display Mode Selector (Total Days vs Weeks vs Months vs Years) -->
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap">طريقة العرض:</span>
        <select
          id="display-mode-select"
          class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-bold text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 cursor-pointer"
        >
          <option value="days">إجمالي الأيام</option>
          <option value="weeks_days">أسابيع وأيام</option>
          <option value="months_days">شهور وأيام</option>
          <option value="years_months_days">سنوات وشهور وأيام</option>
        </select>
      </div>
    </div>

    <!-- Events Grid Container -->
    <div id="events-grid" class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

    <!-- Empty State (Shown if no events match) -->
    <div id="empty-state" class="hidden text-center py-20 px-4">
      <div class="mx-auto w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800/80 flex items-center justify-center text-slate-400 mb-4">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200">لا توجد مناسبات مضافة بعد</h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">
        ابدأ الآن بإضافة أول مناسبة، عيد ميلاد، موعد امتحان، أو ذكرى هامة لتتبعها بدقة!
      </p>
      <button
        id="empty-add-btn"
        type="button"
        class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all cursor-pointer"
      >
        <span>إضافة أول حدث الآن</span>
      </button>
    </div>
  </div>

  <!-- Create/Edit Event Modal -->
  <div id="event-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
        <h3 id="modal-title" class="text-lg font-bold">إضافة حدث جديد</h3>
        <button id="close-modal-btn" type="button" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="event-form" class="space-y-4 mt-5">
        <input type="hidden" id="event-id" name="id" value="" />

        <div>
          <label for="event-title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            عنوان الحدث <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="event-title"
            name="title"
            required
            placeholder="مثال: حفل التخرج، موعد السفر، عيد ميلاد"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
          />
        </div>

        <div>
          <label for="event-desc" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            الوصف (اختياري)
          </label>
          <textarea
            id="event-desc"
            name="description"
            rows="2"
            placeholder="ملاحظات وتفاصيل إضافية عن المناسبة..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
          ></textarea>
        </div>

        <div>
          <label for="event-date" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            تاريخ المناسبة <span class="text-rose-500">*</span>
          </label>
          <input
            type="date"
            id="event-date"
            name="targetDate"
            required
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="event-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              التصنيف
            </label>
            <select
              id="event-category"
              name="category"
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            >
              <option value="general">عام</option>
              <option value="personal">مناسبة شخصية</option>
              <option value="work">عمل ومشاريع</option>
              <option value="study">دراسة وامتحانات</option>
              <option value="travel">سفر وعطلة</option>
              <option value="anniversary">ذكرى سنوية</option>
            </select>
          </div>

          <div>
            <label for="event-color" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              لون البطاقة
            </label>
            <select
              id="event-color"
              name="color"
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            >
              <option value="emerald">أخضر زمردي</option>
              <option value="sky">أزرق سماوي</option>
              <option value="violet">بنفسجي أنيق</option>
              <option value="amber">كهرماني دافئ</option>
              <option value="rose">وردي مميز</option>
              <option value="indigo">نيلي كلاسيكي</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="event-reminder" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              توقيت التنبيه المسبق
            </label>
            <select
              id="event-reminder"
              name="reminderPreset"
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            >
              <option value="none">بدون تنبيه</option>
              <option value="at_time">في يوم الحدث نفسه</option>
              <option value="1_day_before" selected>قبل الحدث بيوم</option>
              <option value="3_days_before">قبل الحدث بـ 3 أيام</option>
              <option value="1_week_before">قبل الحدث بأسبوع</option>
            </select>
          </div>

          <div>
            <label for="event-recurrence" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              تكرار التنبيه الدوري
            </label>
            <select
              id="event-recurrence"
              name="recurrence"
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            >
              <option value="none">مرة واحدة فقط</option>
              <option value="daily">تنبيه يومي بالمدة</option>
              <option value="weekly">تنبيه أسبوعي بالمدة</option>
            </select>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-modal-btn"
            class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800"
          >
            إلغاء
          </button>
          <button
            type="submit"
            id="save-event-btn"
            class="px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/20"
          >
            حفظ الحدث
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Initial events serialized for instant hydration -->
  <script is:inline id="initial-events-data" type="application/json" set:html={JSON.stringify(initialEvents)}></script>

  <!-- Client Side Reactive Logic -->
  <script is:inline>
    let eventsList = [];
    try {
      const raw = document.getElementById('initial-events-data').textContent;
      eventsList = JSON.parse(raw || '[]');
    } catch (e) {
      eventsList = [];
    }

    let activeFilter = 'all';
    let displayMode = 'days';

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.className = `fixed bottom-6 left-6 z-50 p-4 rounded-xl shadow-xl text-xs font-bold transition-all max-w-sm ${
        type === 'success'
          ? 'bg-emerald-600 text-white'
          : 'bg-rose-600 text-white'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }

    const categoryLabels = {
      general: 'عام',
      personal: 'مناسبة شخصية',
      work: 'عمل ومشاريع',
      study: 'دراسة وامتحانات',
      travel: 'سفر وعطلة',
      anniversary: 'ذكرى سنوية',
    };

    const colorClasses = {
      emerald: {
        border: 'border-emerald-500/30',
        badge: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
        accent: 'from-emerald-600 to-teal-500',
      },
      sky: {
        border: 'border-sky-500/30',
        badge: 'bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20',
        accent: 'from-sky-600 to-cyan-500',
      },
      violet: {
        border: 'border-violet-500/30',
        badge: 'bg-violet-500/10 text-violet-600 dark:text-violet-400 border-violet-500/20',
        accent: 'from-violet-600 to-purple-500',
      },
      amber: {
        border: 'border-amber-500/30',
        badge: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
        accent: 'from-amber-600 to-orange-500',
      },
      rose: {
        border: 'border-rose-500/30',
        badge: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20',
        accent: 'from-rose-600 to-pink-500',
      },
      indigo: {
        border: 'border-indigo-500/30',
        badge: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20',
        accent: 'from-indigo-600 to-blue-500',
      },
    };

    function calculateEventDiff(targetDateStr) {
      const target = new Date(targetDateStr);
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const targetDay = new Date(target.getFullYear(), target.getMonth(), target.getDate());

      const msPerDay = 1000 * 60 * 60 * 24;
      const diffMs = targetDay.getTime() - today.getTime();
      const isPast = diffMs < 0;
      const totalDays = Math.abs(Math.round(diffMs / msPerDay));

      const earlier = isPast ? targetDay : today;
      const later = isPast ? today : targetDay;

      let y = later.getFullYear() - earlier.getFullYear();
      let m = later.getMonth() - earlier.getMonth();
      let d = later.getDate() - earlier.getDate();

      if (d < 0) {
        const prevMonthDate = new Date(later.getFullYear(), later.getMonth(), 0);
        d += prevMonthDate.getDate();
        m--;
      }
      if (m < 0) {
        m += 12;
        y--;
      }

      return {
        isPast,
        totalDays,
        years: Math.max(0, y),
        months: Math.max(0, m),
        days: Math.max(0, d),
      };
    }

    function formatDisplay(diff, mode) {
      switch (mode) {
        case 'days':
          return `${diff.totalDays} يوم`;
        case 'weeks_days': {
          const w = Math.floor(diff.totalDays / 7);
          const remDays = diff.totalDays % 7;
          if (w === 0) return `${remDays} يوم`;
          if (remDays === 0) return `${w} أسبوع`;
          return `${w} أسبوع و ${remDays} يوم`;
        }
        case 'months_days': {
          const totalMonths = diff.years * 12 + diff.months;
          if (totalMonths === 0) return `${diff.days} يوم`;
          if (diff.days === 0) return `${totalMonths} شهر`;
          return `${totalMonths} شهر و ${diff.days} يوم`;
        }
        case 'years_months_days':
        default: {
          const parts = [];
          if (diff.years > 0) parts.push(`${diff.years} سنة`);
          if (diff.months > 0) parts.push(`${diff.months} شهر`);
          if (diff.days > 0 || parts.length === 0) parts.push(`${diff.days} يوم`);
          return parts.join(' و ');
        }
      }
    }

    function renderEvents() {
      const grid = document.getElementById('events-grid');
      const emptyState = document.getElementById('empty-state');
      if (!grid) return;

      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      let upcomingCount = 0;
      let pastCount = 0;

      eventsList.forEach((ev) => {
        const t = new Date(ev.targetDate);
        const targetDay = new Date(t.getFullYear(), t.getMonth(), t.getDate());
        if (targetDay >= today) {
          upcomingCount++;
        } else {
          pastCount++;
        }
      });

      document.getElementById('count-all').textContent = eventsList.length;
      document.getElementById('count-upcoming').textContent = upcomingCount;
      document.getElementById('count-past').textContent = pastCount;

      const filtered = eventsList.filter((ev) => {
        const t = new Date(ev.targetDate);
        const targetDay = new Date(t.getFullYear(), t.getMonth(), t.getDate());
        const isUpcoming = targetDay >= today;
        if (activeFilter === 'upcoming') return isUpcoming;
        if (activeFilter === 'past') return !isUpcoming;
        return true;
      });

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      grid.innerHTML = filtered
        .map((ev) => {
          const diff = calculateEventDiff(ev.targetDate);
          const color = colorClasses[ev.color] || colorClasses.emerald;
          const statusText = diff.isPast ? 'مضى منذ' : 'متبقي';
          const badgeClass = diff.isPast
            ? 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
            : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';

          const primaryDuration = formatDisplay(diff, displayMode);
          const targetFormatted = new Date(ev.targetDate).toLocaleDateString('ar-EG', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });

          return `
            <div class="relative group rounded-3xl bg-white dark:bg-slate-900 border ${color.border} p-6 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold ${color.badge}">
                    ${categoryLabels[ev.category] || 'عام'}
                  </span>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold ${badgeClass}">
                    ${statusText}
                  </span>
                </div>

                <h3 class="text-lg font-black text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  ${ev.title}
                </h3>
                ${
                  ev.description
                    ? `<p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">${ev.description}</p>`
                    : ''
                }
              </div>

              <!-- Main Duration Display (Clean, Days/Weeks/Months only) -->
              <div class="my-6 p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-100 dark:border-slate-800/80 text-center">
                <div class="text-3xl sm:text-4xl font-black bg-gradient-to-r ${color.accent} bg-clip-text text-transparent font-mono">
                  ${primaryDuration}
                </div>
              </div>

              <div>
                <div class="text-[11px] text-slate-400 dark:text-slate-500 mb-4 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>${targetFormatted}</span>
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800/80">
                  <div class="text-[11px] text-slate-400 flex items-center gap-1">
                    ${
                      ev.reminderPreset && ev.reminderPreset !== 'none'
                        ? `<span class="inline-flex items-center text-emerald-500 gap-1"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>تنبيه مفعل</span>`
                        : 'بدون تنبيه'
                    }
                  </div>

                  <div class="flex items-center gap-2">
                    <button
                      onclick="editEvent('${ev.id}')"
                      class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                      title="تعديل الحدث"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                    <button
                      onclick="deleteEvent('${ev.id}')"
                      class="p-1.5 rounded-lg text-rose-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
                      title="حذف الحدث"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
        })
        .join('');
    }

    const modal = document.getElementById('event-modal');
    const form = document.getElementById('event-form');

    function openModal(isEdit = false, ev = null) {
      form.reset();
      document.getElementById('modal-title').textContent = isEdit ? 'تعديل الحدث' : 'إضافة حدث جديد';
      if (isEdit && ev) {
        document.getElementById('event-id').value = ev.id;
        document.getElementById('event-title').value = ev.title;
        document.getElementById('event-desc').value = ev.description || '';
        document.getElementById('event-date').value = ev.targetDate ? ev.targetDate.split('T')[0] : '';
        document.getElementById('event-category').value = ev.category || 'general';
        document.getElementById('event-color').value = ev.color || 'emerald';
        document.getElementById('event-reminder').value = ev.reminderPreset || '1_day_before';
        document.getElementById('event-recurrence').value = ev.recurrence || 'none';
      } else {
        document.getElementById('event-id').value = '';
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        const isoDate = tomorrow.toISOString().split('T')[0];
        document.getElementById('event-date').value = isoDate;
      }
      modal.classList.remove('hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    document.getElementById('open-create-modal')?.addEventListener('click', () => openModal(false));
    document.getElementById('empty-add-btn')?.addEventListener('click', () => openModal(false));
    document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
    document.getElementById('cancel-modal-btn')?.addEventListener('click', closeModal);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-event-btn');
      saveBtn.disabled = true;
      saveBtn.textContent = 'جاري الحفظ...';

      const id = document.getElementById('event-id').value;
      const title = document.getElementById('event-title').value;
      const description = document.getElementById('event-desc').value;
      const targetDate = document.getElementById('event-date').value;
      const category = document.getElementById('event-category').value;
      const color = document.getElementById('event-color').value;
      const reminderPreset = document.getElementById('event-reminder').value;
      const recurrence = document.getElementById('event-recurrence').value;

      const payload = {
        title,
        description,
        targetDate,
        category,
        color,
        reminderPreset,
        recurrence,
      };

      try {
        const url = id ? `/api/items/${id}` : '/api/items';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload),
        });

        let data = {};
        try {
          data = await res.json();
        } catch (_) {}

        if (res.status === 401) {
          showToast('انتهت الجلسة. يرجى تسجيل الدخول مجدداً', 'error');
          setTimeout(() => {
            window.location.href = '/login';
          }, 1500);
          return;
        }

        if (!res.ok) {
          throw new Error(data.error || `تعذر حفظ الحدث (رمز: ${res.status})`);
        }

        if (id) {
          const idx = eventsList.findIndex((item) => item.id === id);
          if (idx !== -1) eventsList[idx] = data.event;
          showToast('تم تعديل الحدث بنجاح');
        } else {
          eventsList.push(data.event);
          showToast('تمت إضافة الحدث الجديد بنجاح');
        }

        closeModal();
        renderEvents();
      } catch (err) {
        console.error('Save event error:', err);
        showToast(err.message || 'حدث خطأ في الاتصال بالخادم', 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'حفظ الحدث';
      }
    });

    window.editEvent = function (id) {
      const ev = eventsList.find((item) => item.id === id);
      if (ev) openModal(true, ev);
    };

    window.deleteEvent = async function (id) {
      if (!confirm('هل أنت متأكد من رغبتك في حذف هذا الحدث؟')) return;

      try {
        const res = await fetch(`/api/items/${id}`, {
          method: 'DELETE',
          credentials: 'same-origin',
        });
        if (!res.ok) throw new Error('فشل حذف الحدث');

        eventsList = eventsList.filter((item) => item.id !== id);
        showToast('تم حذف الحدث بنجاح');
        renderEvents();
      } catch (err) {
        showToast(err.message, 'error');
      }
    };

    document.querySelectorAll('.filter-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-tab').forEach((b) => {
          b.className =
            'filter-tab px-3.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200';
        });
        btn.className =
          'filter-tab px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm';
        activeFilter = btn.getAttribute('data-filter') || 'all';
        renderEvents();
      });
    });

    document.getElementById('display-mode-select')?.addEventListener('change', (e) => {
      displayMode = e.target.value;
      renderEvents();
    });

    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
      const rawData = window.atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    async function checkPushPermission() {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        return;
      }
      const banner = document.getElementById('push-prompt-banner');
      if (Notification.permission === 'default' && banner) {
        banner.classList.remove('hidden');
      }
    }

    document.getElementById('enable-push-btn')?.addEventListener('click', async () => {
      try {
        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
          showToast('تم رفض إذن الإشعارات', 'error');
          return;
        }

        const reg = await navigator.serviceWorker.ready;
        const keyRes = await fetch('/api/push/vapid-public-key');
        const { publicKey } = await keyRes.json();

        const subscription = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(publicKey),
        });

        const subJson = subscription.toJSON();
        await fetch('/api/push/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            endpoint: subscription.endpoint,
            keys: subJson.keys,
            userAgent: navigator.userAgent,
          }),
        });

        document.getElementById('push-prompt-banner')?.classList.add('hidden');
        showToast('تم تفعيل إشعارات PWA بنجاح!');
      } catch (err) {
        console.error('Push subscription failed:', err);
        showToast('تعذر الاشتراك في الإشعارات: ' + err.message, 'error');
      }
    });

    document.getElementById('test-push-btn')?.addEventListener('click', async () => {
      try {
        showToast('جاري إرسال إشعار التجربة...');
        const res = await fetch('/api/push/test', { method: 'POST' });
        const data = await res.json();
        if (res.ok) {
          showToast(data.message || 'تم إرسال إشعار التجربة بنجاح');
        } else {
          showToast(data.error || 'تعذر إرسال الإشعار. يرجى تفعيل التنبيهات أولاً.', 'error');
        }
      } catch (e) {
        showToast('حدث خطأ في إرسال الإشعار', 'error');
      }
    });

    renderEvents();
    checkPushPermission();
  </script>
</Layout>
